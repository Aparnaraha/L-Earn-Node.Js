# .env FILE — ENVIRONMENT VARIABLES
# This file stores secret values like database passwords
# Never share this file or push it to GitHub
# process.env.MONGO_URI in your code reads this value

# MONGO_URI is the address of your MongoDB database
# mongodb://localhost:27017 means: MongoDB running on YOUR computer
# todoDB is the name of the database (MongoDB creates it automatically)
MONGO_URI=mongodb://localhost:27017/todoDB